# Copy this file to .env.local and set your real key.
# Do NOT commit .env.local with real secrets.

# Supabase client configuration (safe to expose only with correct RLS).
# The VITE_PUBLIC_* variants are Supabase's newer documented naming — set either pair.
VITE_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SUPABASE_ANON_KEY=
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Generative Language (Gemini) API key.
# Server-side: prefer GEMINI_API_KEY (never prefix with VITE_ — never exposed to the browser).
# Client-side fallback (demo/local only): VITE_GEMINI_API_KEY (leaks key to the bundle; do NOT use in production).
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Disable demo-only UI behavior in production.
VITE_ENABLE_DEMO_MODE=false

# Example usage (macOS/Linux):
# export GEMINI_API_KEY=your_real_key_here
# npm run dev
