# Copy this file to .env.local and set your real key.
# Do NOT commit .env.local with real secrets.

# Supabase client configuration (safe to expose only with correct RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Generative Language (Gemini) API key — server only; never prefix with VITE_
GEMINI_API_KEY=

# Disable demo-only UI behavior in production.
VITE_ENABLE_DEMO_MODE=false

# Example usage (macOS/Linux):
# export GEMINI_API_KEY=your_real_key_here
# npm run dev
